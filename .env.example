# Copy to .env and fill in. Never commit .env.
# Model IDs below were verified with `python scripts/check_models.py` on: 2026-10-26
# (gemini-3.8-flash / 3.7-flash returned 503 on the free tier that day; 3.5-flash-lite answered and supports tool calling)

# ---- LLM providers: two different providers (Google + NVIDIA) ----
GOOGLE_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the primary Gemini model hits a 429/503 (separate free-tier quota per model),
# before the router falls back to NVIDIA
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash

NVIDIA_API_KEY=nvapi-your-key
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Seconds before an LLM call is abandoned and the router falls back to the other provider
LLM_TIMEOUT_S=25

# ---- Embeddings: local sentence-transformers (no key needed) ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Vector store: embedded Chroma, built from data/corpus by `python -m src.rag.ingest` ----
CHROMA_PERSIST_DIR=./chroma_index
RETRIEVAL_K=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ---- Real-time knowledge: Tavily Remote MCP (key goes in the MCP URL query string) ----
TAVILY_API_KEY=tvly-your-key

# ---- Durable conversation state ----
# memory = local dev only (not durable). firestore = Cloud Run (set by deploy.sh).
STATE_BACKEND=memory
FIRESTORE_COLLECTION=sessions

# ---- Cloud Run deployment (used by deploy.sh) ----
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=multi-agent-rag
